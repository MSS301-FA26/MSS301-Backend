# ==============================================================================
# IDENTITY & ACCESS SERVICE (.env.example)
# ==============================================================================
SERVER_PORT=8081

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5431/identity_db
DB_USERNAME=identity_user
DB_PASSWORD=identity_pass_123

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# Mail / Gmail SMTP
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_FROM=your-email@gmail.com

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_TOKEN_INFO_BASE_URL=https://oauth2.googleapis.com

# Seed Accounts
SEED_ADMIN_EMAIL=admin@cinemaai.com
SEED_ADMIN_PASSWORD=Admin123
SEED_ADMIN_FULL_NAME=CinemaAI Admin
SEED_ADMIN_PHONE=0900000001

SEED_STAFF_EMAIL=staff@cinemaai.com
SEED_STAFF_FULL_NAME=CinemaAI Staff
SEED_STAFF_PASSWORD=Staff123
SEED_STAFF_PHONE=0900000002

# Trusted Gateway Secret
INTERNAL_GATEWAY_SECRET=cineai-gateway-secret-token-change-in-production
