# ==============================================================================
# IDENTITY & ACCESS SERVICE (.env.example)
# ==============================================================================
APPLICATION_NAME=identity-service
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5431/identity_db
DB_USERNAME=identity_user
DB_PASSWORD=identity_pass_123
DB_DRIVER=org.postgresql.Driver

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_OPEN_IN_VIEW=false
JPA_FORMAT_SQL=true

# Flyway Migration
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_VALIDATE_ON_MIGRATE=true
FLYWAY_LOCATIONS=classpath:db/migration

# JWT Configuration
JWT_SECRET=cineai-development-secret-key-please-change-123456
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Mail / Gmail SMTP
MAIL_ENABLED=true
MAIL_FROM=your-email@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_TOKEN_INFO_BASE_URL=https://oauth2.googleapis.com

# Seed Accounts
SEED_ADMIN_EMAIL=admin@cinemaai.com
SEED_ADMIN_PASSWORD=Admin123
SEED_ADMIN_FULL_NAME=CinemaAI Admin
SEED_ADMIN_PHONE=0900000001

SEED_MANAGER_EMAIL=manager@cinemaai.com
SEED_MANAGER_PASSWORD=Admin123
SEED_MANAGER_FULL_NAME=CinemaAI Manager
SEED_MANAGER_PHONE=0900000003

SEED_STAFF_EMAIL=staff@cinemaai.com
SEED_STAFF_PASSWORD=Staff123@
SEED_STAFF_FULL_NAME=CinemaAI Staff
SEED_STAFF_PHONE=0900000002
SEED_STAFF_CINEMA_ID=1

# Trusted Secrets
INTERNAL_GATEWAY_SECRET=8F78D52690EED1A48867F89272F07391B8FBC8968F187BB5C53C60E20243D7AD
INTERNAL_SERVICE_SECRET=CF419427F61EE9D8880297E0309BDFB4504B8917C10B7019A56B1562344DDA03

# Actuator & Tracing
MANAGEMENT_ENDPOINTS=health,info
HEALTH_SHOW_DETAILS=never
LOG_LEVEL_PATTERN=%5p [correlationId:%X{correlationId}]

# SpringDoc OpenAPI
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_ENABLED=false
