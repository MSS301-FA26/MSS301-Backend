# ==============================================================================
# SPRING CLOUD API GATEWAY (.env.example)
# ==============================================================================
SERVER_PORT=8080

# Downstream Microservices URIs
IDENTITY_SERVICE_URI=http://localhost:8081
CATALOG_SERVICE_URI=http://localhost:8082
BOOKING_SERVICE_URI=http://localhost:8083
PAYMENT_SERVICE_URI=http://localhost:8084
RECOMMENDATION_SERVICE_URI=http://localhost:8000

# JWT Verification Key
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Shared secret between API Gateway and downstream microservices
INTERNAL_GATEWAY_SECRET=8F78D52690EED1A48867F89272F07391B8FBC8968F187BB5C53C60E20243D7AD
CODEC_MAX_IN_MEMORY_SIZE=100MB

