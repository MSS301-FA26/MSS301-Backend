# ==============================================================================
# RECOMMENDATION AI SERVICE (FastAPI) (.env.example)
# ==============================================================================
HOST=0.0.0.0
PORT=8000

# Database Configuration
DB_HOST=localhost
DB_PORT=5435
DB_NAME=recommendation_db
DB_USER=rec_user
DB_PASSWORD=rec_pass_123

# RabbitMQ Event Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Local Ollama / AI Models
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=your-openai-key

# Recommendation Scoring Weights
REC_W_TRAILER_COMPLETE=5.0
REC_W_TRAILER_VIEW_MAX=5.0
REC_W_TRAILER_CLICK=1.0
REC_W_TRAILER_SKIP=-1.0
REC_W_BOOKING=4.0
REC_W_TICKET_COUNT_MAX=1.5
REC_W_TICKET_COUNT_SATURATION=6
REC_W_REVIEW_HIGH_MULT=1.5
REC_W_REVIEW_LOW_CAP=-2.0
REC_W_WISHLIST=3.0
REC_W_ACTOR_MULT=1.2
REC_W_DIRECTOR_MULT=1.1
REC_W_RECENCY_BONUS=0.5
REC_W_RECENCY_MONTHS=6

# Shared secret between API Gateway and downstream microservices
INTERNAL_GATEWAY_SECRET=8F78D52690EED1A48867F89272F07391B8FBC8968F187BB5C53C60E20243D7AD
