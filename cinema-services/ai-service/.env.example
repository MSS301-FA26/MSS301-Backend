# CinemaAI - ai-service environment configuration
SERVER_PORT=8000

# Security
INTERNAL_GATEWAY_SECRET=cinema-gateway-secret-key-change-in-production
INTERNAL_SERVICE_SECRET=cinema-internal-service-secret-key-change-in-production

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5435
DB_NAME=recommendation_db
DB_USER=rec_user
DB_PASSWORD=rec_pass_123

# RabbitMQ Event Broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# OpenAI-Compatible LLM for Chatbot (Paper 3)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
