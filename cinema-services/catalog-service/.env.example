APPLICATION_NAME=catalog-service
SERVER_PORT=8082
# Containers: use 0.0.0.0 without publishing the service port.
SERVER_ADDRESS=127.0.0.1
DB_URL=jdbc:postgresql://localhost:5432/catalog_db
DB_USERNAME=catalog_user
DB_PASSWORD=replace-with-local-password
DB_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=validate
JPA_OPEN_IN_VIEW=false
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
MANAGEMENT_ENDPOINTS=health,info
HEALTH_SHOW_DETAILS=never
INTERNAL_GATEWAY_SECRET=replace-with-shared-gateway-secret
INTERNAL_SERVICE_SECRET=replace-with-booking-service-secret
JWT_SECRET=replace-with-same-at-least-32-byte-identity-signing-secret
QUOTE_TTL_SECONDS=300
LOG_LEVEL_PATTERN=%5p [correlationId:%X{correlationId}]
