# ==============================================================================
# CATALOG & PRICING SERVICE (.env.example)
# ==============================================================================
APPLICATION_NAME=catalog-service
SERVER_PORT=8082
SERVER_ADDRESS=127.0.0.1

# Database Configuration (PostgreSQL Port 5432)
DB_URL=jdbc:postgresql://localhost:5432/catalog_db
DB_USERNAME=catalog_user
DB_PASSWORD=catalog_pass_123
DB_DRIVER=org.postgresql.Driver

# JPA & Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_OPEN_IN_VIEW=false
JPA_FORMAT_SQL=true

# Flyway Migration
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_VALIDATE_ON_MIGRATE=false
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# Actuator & Health
MANAGEMENT_ENDPOINTS=health,info
HEALTH_SHOW_DETAILS=never
LOG_LEVEL_PATTERN=%5p [correlationId:%X{correlationId}]

# Gateway & Inter-Service Security
INTERNAL_GATEWAY_SECRET=your-secure-internal-gateway-secret-at-least-32-chars
INTERNAL_SERVICE_SECRET=your-secure-internal-service-secret-at-least-32-chars

# JWT Verification Secret (Must match identity-service)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# Business Rules
QUOTE_TTL_SECONDS=300

# SpringDoc OpenAPI
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_ENABLED=false

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Upload Limits & Cache
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB
CACHE_TYPE=simple
CACHE_NAMES=publicMovies,publicMovieDetails

# External Services
BOOKING_SERVICE_URL=http://localhost:8083
RECOMMENDATION_SERVICE_URL=http://localhost:8000
