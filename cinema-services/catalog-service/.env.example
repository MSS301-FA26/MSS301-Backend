# ==============================================================================
# CATALOG & PRICING SERVICE (.env.example)
# ==============================================================================
SERVER_PORT=8082

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/catalog_db
DB_USERNAME=catalog_user
DB_PASSWORD=catalog_pass_123

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Multipart Upload Limits
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB

# Cache Configuration
CACHE_TYPE=simple
CACHE_NAMES=publicMovies,publicMovieDetails

# Shared secret between API Gateway and downstream microservices
INTERNAL_GATEWAY_SECRET=8F78D52690EED1A48867F89272F07391B8FBC8968F187BB5C53C60E20243D7AD
