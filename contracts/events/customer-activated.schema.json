{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CustomerActivatedEvent",
  "description": "Identity-owned internal event. No credentials or profile fields.",
  "type": "object",
  "required": ["eventId", "userId", "occurredAt", "correlationId"],
  "additionalProperties": false,
  "properties": {
    "eventId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "userId": {"type": "integer", "minimum": 1},
    "occurredAt": {
      "type": "string",
      "description": "ISO-8601 local date-time, matching existing Java LocalDateTime event convention.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,9})?)?$"
    },
    "correlationId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}
  }
}
